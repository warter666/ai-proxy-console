# ============================================================
# 凭据与密钥 —— 绝不入库
# ============================================================
wb-key-payload.json
*key*.json
*secret*
*.pem
*.key
.env
.env.*

# 设备指纹（含真实 device_id / uid / web_id）
doubao-consumer-config.json

# 外部网关配置（含用户填的 token 明文）
custom_gateways.json

# 用户自定义客户端（含本机安装路径）
clients.json
# 内置客户端的本机安装路径覆盖（格式见 clients.example.json）
clients.local.json

# 本机面板设置（引擎仓库 / 账号目录等本机路径）
config/panel.local.json

# 内置引擎的账号数据（导出的凭据）与回滚归档，绝不入库
engine/accounts/
engine/qoder/accounts/

# ============================================================
# 进程/内存读取工具 —— 仅限本机自用，不入库
#   这些脚本会读取其他进程的内存与环境变量，
#   公开分发性质完全不同，故排除。需要的自行保留本地副本。
# ============================================================
scan_mem.py
wb_decrypt.py
read_proc_env.py

# ============================================================
# 运行时产物
# ============================================================
workbuddy-proxy.log*
*.log
*.pid
panel_launch.*
capture/
logs/
__pycache__/
*.pyc
*.pyo

# 会话/临时抓包（可能含真实对话与凭据）
*.bak-*
*.bak

# 本机 agent 运行时记忆与一次性探针，不入库
.workbuddy/
_dsh_sess_probe.py

# ============================================================
# 占位但不入库的大件
# ============================================================
# .dsh 是指向 AgentHub 技能库的 junction（1.5GB），
# 技能本体在 AgentHub 仓库维护，此处只保留接入说明。
.dsh/

# ============================================================
# 生成的 EXE 启动器（源码在 tools/launcher，运行 build-launchers.ps1 重建）
# ============================================================
*.exe
tools/launcher/agent-hub.ico

# 归档的旧入口（保留本机可回溯，不入库）
_legacy/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ============================================================
# 预览图（可选产物，需要时单独加 -f 提交）
# ============================================================
panel_v2_preview.png

# ============================================================
# 个人规则 / 规划 / 交接文档 —— 不进公开仓库，本地保留
#   AGENTS.md / CLAUDE.md：本机 agent 规则（含 AgentHub 兼容路径）
#   notes/：交接日志 / 设计记录（含会话 ID、账号号等低敏标识）
#   PROGRESS.md：跨天进度总账
#   tools/diagnostics/：一次性诊断脚本（已删除，留 ignore 防误加）
# ============================================================
AGENTS.md
CLAUDE.md
notes/
PROGRESS.md
tools/diagnostics/

